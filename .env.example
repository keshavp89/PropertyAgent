# Server-only. Set these in Vercel → Project → Settings → Environment Variables.
# Do not prefix them with NEXT_PUBLIC_. The browser must never receive them.

# Pooled Neon host (hostname contains -pooler). Application traffic.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/PropertyDB?sslmode=verify-full"

# Direct Neon host (no -pooler). Prisma migrations only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/PropertyDB?sslmode=verify-full"

# Managed Neon Auth base URL for this branch, including the /auth path.
NEON_AUTH_BASE_URL="https://ep-example.neonauth.region.aws.neon.tech/PropertyDB/auth"

# 32+ characters. openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""
