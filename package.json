{
  "name": "property-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/matching.test.ts src/lib/access.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "guard": "node scripts/guard-client-secrets.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/auth": "0.7.0-beta",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "next": "16.4.6",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
